{
	"name": "sixteal-app",
	"private": true,
	"description": "Six Teal Store is a modern e-commerce platform that offers a wide range of products and services to customers worldwide. Our mission is to provide a seamless shopping experience with high-quality products, competitive prices, and exceptional customer service.",
	"type": "module",
	"scripts": {
		"arch": "depcruise src --config .dependency-cruiser.cjs",
		"build:check": "bun build src/index.ts --outdir dist --target bun",
		"check": "bun run verify",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deps:upgrade": "ncu -i",
		"dev": "bun --watch src/app/server.ts",
		"format": "biome format --write .",
		"knip": "bunx --bun knip",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "husky || true",
		"secrets": "secretlint \"**/*\"",
		"spell": "cspell --no-progress \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\"",
		"start": "bun src/app/server.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"type-coverage": "type-coverage --strict --at-least 100 --ignore-catch",
		"typecheck": "tsc --noEmit",
		"verify": "bun run typecheck && bun run lint:fix && bun run type-coverage && bun run knip && bun run spell && bun run test"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"drizzle-orm": "^0.45.3",
		"elysia": "^1.4.30",
		"jose": "^6.2.13",
		"postgres": "^3.4.9",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@faker-js/faker": "^10.6.0",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.4",
		"cspell": "^10.4.0",
		"dependency-cruiser": "^18.7.0",
		"drizzle-kit": "^0.31.11",
		"husky": "^9.1.7",
		"knip": "^6.43.0",
		"lint-staged": "^17.6.0",
		"npm-check-updates": "^23.1.1",
		"secretlint": "^13.0.7",
		"sort-package-json": "^4.1.0",
		"type-coverage": "^2.30.4",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.2.0"
	}
}
